# Salin file ini menjadi .env (file .env tidak ikut di-commit)
PORT=3000
# Kunci rahasia untuk menandatangani token JWT — ganti dengan string acak yang panjang
JWT_SECRET=ganti-dengan-string-acak
# Alamat web-admin yang boleh memanggil API (dev server Vite). Pisahkan dengan koma jika lebih dari satu.
CORS_ORIGIN=http://localhost:5173
